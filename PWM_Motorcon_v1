; Example 1: Set duty cycle at 25%
    ; See HoPE p. 566
    ; CCPRL1 = 0.25 x (PR2+1) = 0.25 x 20 = 5
    
    ;Pulse Width = CCPRxL:CCP1CON<5:4>. TOSC . (TMRx Prescale Value)
    
    ;Duty Cycle= (CCPR1L+CCP1CON<5:4>)/(PR2+1)4
    
    PROCESSOR 18F45K22

    CONFIG  FOSC = INTIO67        ; Internal oscillator
    CONFIG  WDTEN = OFF           ; Disable Watchdog Timer

    #include <xc.inc>
    #include "pic18f45k22.inc"

PSECT code, abs
    org  00h
    goto INIT

INIT:       
    movlw   0b01010000 ; Set internal oscillator to 4 MHz
    movwf   OSCCON
    
   
    movlw   19         ; PWM period of 50 kHz
    movwf   PR2        ; 0001 0011
    
    clrf    TMR2          
    clrf    t2con
    
    movlw   0b00000100  ; Configure Timer2 Enable Timer2 with 1:1 prescaler
    movwf   T2CON
    
    movlw   5          ; Set duty cycle to 25% out of 20 15 for 75% the 8 msb in the pwm duty cycle
    movwf   CCPR1L     ; using ccp1 module 
    
    ;Fraction can be approximated in quarters, i.e. 0.25, 0.5, 0.75. We choose 0.5
    ; DC1B<1:0> in CCP1CON<5:4> = 0b10  the 2 lsb in the pwm duty cycle
    bcf	CCP1CON,DC1B0
    bsf	CCP1CON,DC1B1
    
    clrf    PORTC      ;clear port c
    clrf    LATC   
    bcf     TRISC,2    ; RC2/CCP1 as output
   
    BCF     CCP1M0   ; confiure bits for ccp module for pwm mode (11xx)
    BCF     CCP1M1
    BSF     CCP1M2
    BSF     CCP1M3

Main:
    nop    ;keep looping main to keep the ccp module runing
    nop
    nop
    nop
    goto Main

    end
